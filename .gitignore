/target
**/*.rs.bk
*.pdb

# Auto-incrementing build counter (generated by build.rs; not source)
/.build_seq
# The commit stamp publish-share.ps1 adds to a source tarball (`git archive --add-file`), so a
# build without .git can still name its commit. Only ever meaningful INSIDE an archive.
/BUILD-COMMIT.txt

# Local diagnostic screenshots
/diag/

# Local-only scratch folder (notes, experiments, throwaway files) — never version-controlled
/local/

# Validation: commit the golden references + a checked-in report, but ignore the
# per-run timestamped reports and the freshly-rendered comparison images.
/validation/current/
/validation/report-*.md

# Default CLI output filenames (when --out is omitted), written to the cwd
/compare_heatmap.png
/fractadyne_render.png
/fractadyne_iter.exr
/fractadyne_benchmark.txt

# Log files
*.log

# Profiling run logs (--profile writes timestamped JSON here; keep the scripts, not the runs)
/logs/

# OS cruft
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor / IDE
.vscode/
.idea/
.vs/
*.swp
*~
*.orig

# Archived docs (completed/abandoned plans + stale snapshots) — kept locally, out of the tracked repo
/archive/
__pycache__/

# Torture-suite output: per-rung logs, failure artifacts, throwaway config dirs.
validation/torture/
bench-kit/*.zip
bench-kit/results/
# Fraktaler-3 hardware tuning: derived per MACHINE, never portable between them.
bench-kit/f3-wisdom.toml
bench-kit/f3-wisdom-*.toml
bench-kit/apps/
# Derived: package.ps1 stages these from validation/corpus/locations/ (the standard set) and
# bench-kit/ladder/ (the ladder) when building the distributable, and run-all.ps1 refreshes
# the ones a run needs from the same places when it runs in place. Kept out of the repo so the
# copies cannot drift.
bench-kit/scenes/
# FractalShark scratch, written into the CWD wherever it is launched from.
bench-kit/HeapFile.bin
bench-kit/*.iters
dist/

/target
**/*.rs.bk
*.pdb

# Auto-incrementing build counter (generated by build.rs; not source)
/.build_seq

# Local diagnostic screenshots
/diag/

# Local-only scratch folder (notes, experiments, throwaway files) — never version-controlled
/local/

# Validation: commit the golden references + a checked-in report, but ignore the
# per-run timestamped reports and the freshly-rendered comparison images.
/validation/current/
/validation/report-*.md

# Default CLI output filenames (when --out is omitted), written to the cwd
/compare_heatmap.png
/fractadyne_render.png
/fractadyne_iter.exr
/fractadyne_benchmark.txt

# Log files
*.log

# Profiling run logs (--profile writes timestamped JSON here; keep the scripts, not the runs)
/logs/

# OS cruft
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor / IDE
.vscode/
.idea/
.vs/
*.swp
*~
*.orig

# Archived docs (completed/abandoned plans + stale snapshots) — kept locally, out of the tracked repo
/archive/
__pycache__/

# Torture-suite output: per-rung logs, failure artifacts, throwaway config dirs.
validation/torture/
bench-kit/*.zip
bench-kit/results/
bench-kit/apps/
# Derived: package.ps1 stages these from validation/corpus/locations/ when building the
# distributable. Kept out of the repo so the two copies cannot drift - but that means the
# kit will not run IN PLACE until they are staged (run-all.ps1 should do it; see TODO).
bench-kit/scenes/
